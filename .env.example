# Supabase connection (safe to expose: the anon key is public by design and
# Row Level Security protects your data). Copy this file to .env.local and fill in
# the values from your Supabase project (Settings -> API).
#
# The app runs fine WITHOUT these — it just falls back to offline / on-device only
# (progress and tracks saved locally, no sync, live location sharing, news posting
# or photo journal). Fill them in to enable the backend features.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
